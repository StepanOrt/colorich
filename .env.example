# ==========================================
# Immich Server Configuration
# ==========================================
IMMICH_SERVER_URL=https://immich.example.com
IMMICH_API_KEY=your_immich_api_key_here
IMMICH_SHARED_ALBUM_ID=00000000-0000-0000-0000-000000000000

# ==========================================
# Printer Configuration (CUPS / AirPrint)
# ==========================================
PRINTER_NAME=My_AirPrint_Printer
CUPS_SERVER=/run/cups/cups.sock

# ==========================================
# Service & Polling Settings
# ==========================================
POLL_INTERVAL_SECONDS=60
DRY_RUN=false
LOG_LEVEL=INFO
